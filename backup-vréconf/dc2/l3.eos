
DC2-LEAF-3#sh run
! Command: show running-config
! device: DC2-LEAF-3 (vEOS-lab, EOS-4.33.2F)
!
! boot system flash:/vEOS-lab.swi
!
enable password sha512 $6$LqGyROaoV5iZaIck$dPqC6nkD2NrohZEBa3IKRJA73BauIn4ediXlH18weQ3ApfTLCO7YE2kRixo9iWyMAgI7tBTK1wRAm90/kUboX.
no aaa root
!
username cvpadmin privilege 15 secret sha512 $6$/M6tySe.0CtB5CZv$rVY5wujDkMsPcvmGQhniPVnkmRBbDT/O3w1WW/hpOGa3CSFXQ5ClwEnUvg0uxxZil0l8MmE14Oq710jPohAl41
username scp privilege 15 shell /bin/bash secret sha512 $6$5wgDdqbVId68Wr3H$SkH/PcsbKOcXZIXXsmeoDIv17cK77oTQifzDNGV3AOKjA9XmNWfNtGUd09gCRmYJISeF9AI86AImLdfGbB4En/
!
management api http-commands
   protocol http
   no shutdown
   !
   vrf managment
      no shutdown
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname DC2-LEAF-3
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 4094
   trunk group mlag-peer
!
vrf instance customer
!
vrf instance managment
!
aaa authentication login console local
aaa authorization exec default local
!
interface Port-Channel4094
   description MLAG - PEER LINK - lag
   switchport mode trunk
   switchport trunk group mlag-peer
!
interface Ethernet1
   description DC2-SPINE-1
   no switchport
   ip address 172.16.100.5/31
!
interface Ethernet2
   description DC2-SPINE-2
   no switchport
   ip address 172.16.100.13/31
!
interface Ethernet3
   description MLAG - PEER LINK - lag
   channel-group 4094 mode active
!
interface Ethernet4
   description MLAG - PEER LINK - lag
   channel-group 4094 mode active
!
interface Ethernet5
   description DCI - DC2-ISN-2
   no switchport
   ip address 172.16.100.16/31
!
interface Ethernet6
!
interface Ethernet7
!
interface Ethernet8
!
interface Loopback0
   ip address 172.32.0.13/32
!
interface Loopback1
   ip address 2.2.1.2/32
!
interface Loopback100
   vrf customer
   ip address 20.20.20.30/32
!
interface Management1
   vrf managment
   ip address 192.168.28.32/24
!
interface Vlan4094
   description MLAG PEER LINK - lag
   ip address 200.0.0.2/31
!
interface Vxlan1
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan vrf customer vni 1001
!
ip virtual-router mac-address 00:1c:73:00:00:18
!
ip routing
ip routing vrf customer
no ip routing vrf managment
!
ip prefix-list rt-conn
   seq 10 permit 172.32.0.13/32
   seq 20 permit 2.2.1.2/32
!
mlag configuration
   domain-id MLAG4094
   local-interface Vlan4094
   peer-address 200.0.0.3
   peer-link Port-Channel4094
!
ip route vrf managment 0.0.0.0/0 192.168.28.254
!
route-map rt-conn permit 10
   match ip address prefix-list rt-conn
!
router bgp 64002
   router-id 172.32.0.13
   maximum-paths 4 ecmp 4
   neighbor ISN-EVPN-1 peer group
   neighbor ISN-EVPN-1 remote-as 65100
   neighbor ISN-EVPN-1 next-hop-unchanged
   neighbor ISN-EVPN-1 update-source Loopback0
   neighbor ISN-EVPN-1 ebgp-multihop
   neighbor ISN-EVPN-1 send-community extended
   neighbor ISN-UNDERLAY-1 peer group
   neighbor ISN-UNDERLAY-1 remote-as 65100
   no neighbor ISN-UNDERLAY-1 next-hop-unchanged
   neighbor SPINE peer group
   neighbor SPINE bfd
   neighbor SPINE send-community
   neighbor SPINE maximum-routes 12000
   neighbor SPINE-EVPN-TRANSIT peer group
   neighbor SPINE-EVPN-TRANSIT next-hop-unchanged
   neighbor SPINE-EVPN-TRANSIT update-source Loopback0
   neighbor SPINE-EVPN-TRANSIT ebgp-multihop
   neighbor SPINE-EVPN-TRANSIT send-community extended
   neighbor SPINE-EVPN-TRANSIT maximum-routes 0
   neighbor 172.16.100.4 peer group SPINE
   neighbor 172.16.100.4 remote-as 64000
   neighbor 172.16.100.12 peer group SPINE
   neighbor 172.16.100.12 remote-as 64000
   neighbor 172.16.100.17 peer group ISN-UNDERLAY-1
   neighbor 172.16.100.17 description DCI-UNDERLAY-DC2-ISN-2
   neighbor 172.16.200.200 peer group ISN-EVPN-1
   neighbor 172.32.0.1 peer group SPINE-EVPN-TRANSIT
   neighbor 172.32.0.1 remote-as 64000
   neighbor 172.32.0.2 peer group SPINE-EVPN-TRANSIT
   neighbor 172.32.0.2 remote-as 64000
   neighbor 200.0.0.3 remote-as 64002
   neighbor 200.0.0.3 next-hop-self
   neighbor 200.0.0.3 maximum-routes 12000
   redistribute connected
   !
   address-family evpn
      neighbor ISN-EVPN-1 activate
      neighbor SPINE-EVPN-TRANSIT activate
   !
   address-family ipv4
      no neighbor ISN-EVPN-1 activate
      neighbor ISN-UNDERLAY-1 activate
      no neighbor SPINE-EVPN-TRANSIT activate
      network 172.32.0.13/32
   !
   vrf customer
      rd 172.32.0.13:3000
      route-target import 1:1001
      route-target import 1:9999
      route-target export 1:1001
      route-target export 1:9999
      redistribute connected
      redistribute static
!
router multicast
   ipv4
      software-forwarding kernel
   !
   ipv6
      software-forwarding kernel
!
end
