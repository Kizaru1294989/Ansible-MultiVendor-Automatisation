DC1-SPINE-2#sh run
! Command: show running-config
! device: DC1-SPINE-2 (vEOS-lab, EOS-4.33.2F)
!
! boot system flash:/vEOS-lab.swi
!
enable password sha512 $6$LqGyROaoV5iZaIck$dPqC6nkD2NrohZEBa3IKRJA73BauIn4ediXlH18weQ3ApfTLCO7YE2kRixo9iWyMAgI7tBTK1wRAm90/kUboX.
no aaa root
!
username cvpadmin privilege 15 secret sha512 $6$/M6tySe.0CtB5CZv$rVY5wujDkMsPcvmGQhniPVnkmRBbDT/O3w1WW/hpOGa3CSFXQ5ClwEnUvg0uxxZil0l8MmE14Oq710jPohAl41
username scp privilege 15 shell /bin/bash secret sha512 $6$5wgDdqbVId68Wr3H$SkH/PcsbKOcXZIXXsmeoDIv17cK77oTQifzDNGV3AOKjA9XmNWfNtGUd09gCRmYJISeF9AI86AImLdfGbB4En/
!
management api http-commands
   protocol http
   no shutdown
   !
   vrf managment
      no shutdown
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname DC1-SPINE-2
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vrf instance managment
!
aaa authentication login console local
aaa authorization exec default local
!
interface Ethernet1
   description DC1-LEAF-4
   no switchport
   ip address 172.16.200.18/31
!
interface Ethernet2
   description DC1-LEAF-1
   no switchport
   ip address 172.16.200.12/31
!
interface Ethernet3
   description DC1-LEAF-2
   no switchport
   ip address 172.16.200.14/31
!
interface Ethernet4
   description DC1-LEAF-3
   no switchport
   ip address 172.16.200.16/31
!
interface Ethernet5
   description DC1-LEAF-5
   no switchport
   ip address 172.16.200.20/31
!
interface Ethernet6
   description DC1-LEAF-6
   no switchport
   ip address 172.16.200.22/31
!
interface Ethernet7
!
interface Ethernet8
!
interface Loopback0
   ip address 172.16.0.2/32
!
interface Management1
   vrf managment
   ip address 192.168.28.21/24
!
ip routing
no ip routing vrf managment
!
ip prefix-list rt-conn
   seq 10 permit 172.16.0.2/32
!
ip route vrf managment 0.0.0.0/0 192.168.28.254
!
route-map rt-conn permit 10
   match ip address prefix-list rt-conn
!
router bgp 65000
   router-id 172.16.0.2
   maximum-paths 4 ecmp 4
   neighbor LEAF peer group
   neighbor LEAF bfd
   neighbor LEAF send-community
   neighbor LEAF maximum-routes 12000
   neighbor LEAF-EVPN-TRANSIT peer group
   neighbor LEAF-EVPN-TRANSIT next-hop-unchanged
   neighbor LEAF-EVPN-TRANSIT update-source Loopback0
   neighbor LEAF-EVPN-TRANSIT ebgp-multihop
   neighbor LEAF-EVPN-TRANSIT send-community extended
   neighbor LEAF-EVPN-TRANSIT maximum-routes 0
   neighbor 172.16.0.11 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.11 remote-as 65001
   neighbor 172.16.0.12 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.12 remote-as 65001
   neighbor 172.16.0.13 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.13 remote-as 65002
   neighbor 172.16.0.14 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.14 remote-as 65002
   neighbor 172.16.0.15 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.15 remote-as 65003
   neighbor 172.16.0.16 peer group LEAF-EVPN-TRANSIT
   neighbor 172.16.0.16 remote-as 65003
   neighbor 172.16.200.13 peer group LEAF
   neighbor 172.16.200.13 remote-as 65001
   neighbor 172.16.200.15 peer group LEAF
   neighbor 172.16.200.15 remote-as 65001
   neighbor 172.16.200.17 peer group LEAF
   neighbor 172.16.200.17 remote-as 65002
   neighbor 172.16.200.19 peer group LEAF
   neighbor 172.16.200.19 remote-as 65002
   neighbor 172.16.200.21 peer group LEAF
   neighbor 172.16.200.21 remote-as 65003
   neighbor 172.16.200.23 peer group LEAF
   neighbor 172.16.200.23 remote-as 65003
   redistribute connected
   !
   address-family evpn
      bgp next-hop-unchanged
      neighbor LEAF-EVPN-TRANSIT activate
   !
   address-family ipv4
      no neighbor LEAF-EVPN-TRANSIT activate
!
router multicast
   ipv4
      software-forwarding kernel
   !
   ipv6
      software-forwarding kernel
!
end
