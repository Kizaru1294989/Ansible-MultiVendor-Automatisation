DC1-LEAF-1#sh run
! Command: show running-config
! device: DC1-LEAF-1 (vEOS-lab, EOS-4.33.2F)
!
! boot system flash:/vEOS-lab.swi
!
enable password sha512 $6$LqGyROaoV5iZaIck$dPqC6nkD2NrohZEBa3IKRJA73BauIn4ediXlH18weQ3ApfTLCO7YE2kRixo9iWyMAgI7tBTK1wRAm90/kUboX.
no aaa root
!
username cvpadmin privilege 15 secret sha512 $6$/M6tySe.0CtB5CZv$rVY5wujDkMsPcvmGQhniPVnkmRBbDT/O3w1WW/hpOGa3CSFXQ5ClwEnUvg0uxxZil0l8MmE14Oq710jPohAl41
username scp privilege 15 shell /bin/bash secret sha512 $6$5wgDdqbVId68Wr3H$SkH/PcsbKOcXZIXXsmeoDIv17cK77oTQifzDNGV3AOKjA9XmNWfNtGUd09gCRmYJISeF9AI86AImLdfGbB4En/
!
management api http-commands
   protocol http
   no shutdown
   !
   vrf managment
      no shutdown
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname DC1-LEAF-1
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 115-116
!
vlan 4094
   trunk group mlag-peer
!
vrf instance customer
!
vrf instance managment
!
aaa authentication login console local
aaa authorization exec default local
!
interface Port-Channel115
   switchport access vlan 115
   mlag 115
!
interface Port-Channel116
   switchport access vlan 116
   mlag 116
!
interface Port-Channel4094
   description MLAG - PEER LINK - lag
   switchport mode trunk
   switchport trunk group mlag-peer
!
interface Ethernet1
   description DC1-SPINE-1
   no switchport
   ip address 172.16.200.1/31
!
interface Ethernet2
   description DC1-SPINE-2
   no switchport
   ip address 172.16.200.13/31
!
interface Ethernet3
   description MLAG - PEER LINK - lag
   channel-group 4094 mode active
!
interface Ethernet4
   description MLAG - PEER LINK - lag
   channel-group 4094 mode active
!
interface Ethernet5
!
interface Ethernet6
   description HOST-VLAN115
   channel-group 115 mode active
!
interface Ethernet7
   description HOST-VLAN116
   channel-group 116 mode active
!
interface Ethernet8
!
interface Loopback0
   ip address 172.16.0.11/32
!
interface Loopback1
   ip address 1.1.2.1/32
!
interface Loopback100
   vrf customer
   ip address 10.10.10.10/32
!
interface Management1
   vrf managment
   ip address 192.168.28.22/24
!
interface Vlan115
   mtu 9000
   no autostate
   vrf customer
   ip address 172.16.115.2/24
   ip virtual-router address 172.16.115.1/24
!
interface Vlan116
   mtu 9000
   no autostate
   vrf customer
   ip address 172.16.116.2/24
   ip virtual-router address 172.16.116.1/24
!
interface Vlan4094
   description MLAG PEER LINK - lag
   ip address 100.0.0.0/31
!
interface Vxlan1
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan vlan 115 vni 10115
   vxlan vlan 116 vni 10116
   vxlan vrf customer vni 1001
!
ip virtual-router mac-address 00:1c:73:00:00:0c
!
ip routing
ip routing vrf customer
no ip routing vrf managment
!
ip prefix-list rt-conn
   seq 10 permit 172.16.0.11/32
!
mlag configuration
   domain-id MLAG4094
   local-interface Vlan4094
   peer-address 100.0.0.1
   peer-link Port-Channel4094
!
ip route vrf managment 0.0.0.0/0 192.168.28.254
!
route-map rt-conn permit 10
   match ip address prefix-list rt-conn
!
router bgp 65001
   router-id 172.16.0.11
   maximum-paths 4 ecmp 4
   neighbor SPINE peer group
   neighbor SPINE bfd
   neighbor SPINE send-community
   neighbor SPINE maximum-routes 12000
   neighbor SPINE-EVPN-TRANSIT peer group
   neighbor SPINE-EVPN-TRANSIT next-hop-unchanged
   neighbor SPINE-EVPN-TRANSIT update-source Loopback0
   neighbor SPINE-EVPN-TRANSIT ebgp-multihop
   neighbor SPINE-EVPN-TRANSIT send-community extended
   neighbor SPINE-EVPN-TRANSIT maximum-routes 0
   neighbor 100.0.0.1 remote-as 65001
   neighbor 100.0.0.1 next-hop-self
   neighbor 100.0.0.1 maximum-routes 12000
   neighbor 172.16.0.1 peer group SPINE-EVPN-TRANSIT
   neighbor 172.16.0.1 remote-as 65000
   neighbor 172.16.0.2 peer group SPINE-EVPN-TRANSIT
   neighbor 172.16.0.2 remote-as 65000
   neighbor 172.16.200.0 peer group SPINE
   neighbor 172.16.200.0 remote-as 65000
   neighbor 172.16.200.12 peer group SPINE
   neighbor 172.16.200.12 remote-as 65000
   redistribute connected
   !
   vlan 115
      rd 172.16.0.11:10115
      route-target both 1:10115
      redistribute learned
   !
   vlan 116
      rd 172.16.0.11:10116
      route-target both 1:10116
      redistribute learned
   !
   address-family evpn
      neighbor SPINE-EVPN-TRANSIT activate
   !
   address-family ipv4
      no neighbor SPINE-EVPN-TRANSIT activate
      network 172.16.0.11/32
      network 172.16.115.0/24
      network 172.16.116.0/24
   !
   vrf customer
      rd 172.16.0.11:1000
      route-target import 1:1001
      route-target export 1:1001
      route-target export 1:9999
      redistribute connected
      redistribute static
!
router multicast
   ipv4
      software-forwarding kernel
   !
   ipv6
      software-forwarding kernel
!
end